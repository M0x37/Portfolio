{
  "version": 2,
  "framework": null,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "projects.html", "use": "@vercel/static" },
    { "src": "contact.html", "use": "@vercel/static" },
    { "src": "404.html", "use": "@vercel/static" },
    { "src": "Privacy_Policy.html", "use": "@vercel/static" },
    { "src": "datenschutz.html", "use": "@vercel/static" },
    { "src": "css/critical.css", "use": "@vercel/static" },
    { "src": "css/style.css", "use": "@vercel/static" },
    { "src": "bear_cutouts/01_static.png", "use": "@vercel/static" },
    { "src": "bear_cutouts/02_lift.png", "use": "@vercel/static" },
    { "src": "bear_cutouts/03_start_wave.png", "use": "@vercel/static" },
    { "src": "bear_cutouts/04_wave.png", "use": "@vercel/static" },
    { "src": "bear_cutouts/05_transition.png", "use": "@vercel/static" },
    { "src": "bear_cutouts/06_final.png", "use": "@vercel/static" },
    { "src": "assets/images/Ice_Bear_(We_Bare_Bears).svg", "use": "@vercel/static" },
    { "src": "assets/images/icebear_favicon.png", "use": "@vercel/static" },
    { "src": "assets/svg/fish1 (2).svg", "use": "@vercel/static" },
    { "src": "sitemap.xml", "use": "@vercel/static" },
    { "src": "robots.txt", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/projects", "dest": "/projects.html" },
    { "src": "/contact", "dest": "/contact.html" },
    { "src": "/privacy", "dest": "/Privacy_Policy.html" },
    { "src": "/datenschutz", "dest": "/datenschutz.html" },
    { "src": "/404", "dest": "/404.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
